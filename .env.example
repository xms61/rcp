# Copy to .env and fill in. Git ignores .env, and the agent hooks and ignore files keep agents out of it.
# List every variable the project reads, with a comment on what it is for. Never put a real value here.

# apps/api: the one API token the Android app sends, at least 32 characters. Make one with `openssl rand -hex 32`.
RCP_API_TOKEN=
# apps/api: where the API listens. Defaults: 127.0.0.1 and 3000; the Docker image sets HOST=0.0.0.0.
# HOST=127.0.0.1
# PORT=3000
# apps/api: the SQLite file. Default: rcp.db, relative to apps/api in development; the Docker image sets /data/rcp.db.
# RCP_DB_PATH=rcp.db
