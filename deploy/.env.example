# The VPS's settings for deploy/compose.yml. Copy to .env next to compose.yml on the VPS (docs/DEPLOY.md), then
# fill in. HOST and PORT are set in compose.yml and can't be changed here. Never put a real value in this file.

# The one API token the Android app sends, at least 32 characters. Make it on the VPS with `openssl rand -hex 32`.
RCP_API_TOKEN=

# The image version to run, such as 0.2.0. Leave unset for the latest release; set it to roll back.
# RCP_VERSION=
