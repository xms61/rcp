# Dependencies and build output
node_modules/
dist/
build/
coverage/

# Local settings and secrets: only .env.example is committed
.env
.env.*
!.env.example

# Local notes, never committed
docs/scratch/

# Personal agent settings and agent worktrees
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# Local SQLite databases (the API's default is apps/api/rcp.db)
*.db
*.db-shm
*.db-wal

# OS and editor files
.DS_Store
Thumbs.db
*.log

# Impeccable design tool: runtime state of its decision pages
**/.impeccable/questions/

# Impeccable design tool: its detector hook cache
**/.impeccable/hook.cache.json
